# Copy to .env.local and fill in real values (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER-ONLY — needed from Phase 4 (checkout). Do NOT add NEXT_PUBLIC_ to this.
# Never commit the real value. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# SERVER-ONLY — Phase 4 checkout. Use TEST keys first (sk_test_…). Never commit.
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET
